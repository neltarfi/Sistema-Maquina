  object zqClienteSaldo: TZQuery
    Filter = 'Saldo2>0'
    Filtered = True
    Connection = fPrincipal.zConn
    SQL.Strings = (
      'select C.IDCLIENTE,'
      '            cast(C.IDCLIENTE as varchar(10)) || '' '' || C.RAZAO || '' '' || C.Endereco as RAZAO2,'
      '           sum(E.SALDO) as Saldo2'
      'from ESTOQUEDEPOSITOCOCO as E'
      'inner join ROMENTRADACOCO AS R on E.IDROMENTRADACOCO = R.IDROMENTRADACOCO'
      'inner join CLIENTE as C on R.IDCLIENTE = C.IDCLIENTE'
      'group by C.IDCLIENTE, C.RAZAO, C.ENDERECO'
      'order by C.RAZAO'
    )
    Params = <>
    Left = 136
    object zqClienteSaldoIDCLIENTE: TZIntegerField
      FieldKind = fkData
      FieldName = 'IDCLIENTE'
      Index = 0
      LookupCache = False
      ProviderFlags = [pfInUpdate, pfInWhere]
      ReadOnly = False
      Required = True
    end
    object zqClienteSaldoRAZAO2: TZRawStringField
      FieldKind = fkData
      FieldName = 'RAZAO2'
      Index = 1
      LookupCache = False
      ProviderFlags = [pfInUpdate, pfInWhere]
      ReadOnly = True
      Required = False
      Size = 51
    end
    object zqClienteSaldoSALDO2: TZInt64Field
      FieldKind = fkData
      FieldName = 'SALDO2'
      Index = 2
      LookupCache = False
      ProviderFlags = [pfInUpdate, pfInWhere]
      ReadOnly = True
      Required = False
    end
  end
