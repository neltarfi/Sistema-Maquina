  object zqClienteSaldo: TZQuery
    Filter = 'Saldo2>0'
    Filtered = True
    Connection = fPrincipal.zConn
    SQL.Strings = (
      'select C.IDCLIENTE,'
      '            cast(C.IDCLIENTE as varchar(10)) || '' '' || C.RAZAO || '' '' || C.Endereco as RAZAO2,'
      '           sum(E.SALDO) as Saldo2'
      'from ESTOQUEDEPOSITOCOCO as E'
      'inner join ROMENTRADACOCO AS R on E.IDROMENTRADACOCO = R.IDROMENTRADACOCO'
      'inner join CLIENTE as C on R.IDCLIENTE = C.IDCLIENTE'
      'group by C.IDCLIENTE, C.RAZAO, C.ENDERECO'
    )
    Params = <>
    Left = 143
    Top = 11
    object zqClienteSaldoIDCLIENTE: TZIntegerField
      FieldKind = fkData
      FieldName = 'IDCLIENTE'
      Index = 0
      LookupCache = False
